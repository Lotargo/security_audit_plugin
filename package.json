  "description": "Comprehensive Security Audit Plugin with isolated Docker sandbox, Rust kernel, stealth browser, Tor routing and 19 standardized skills.",
  "author": "Lotargo & Antigravity",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "security-audit": "./bin/cli.js",
    "security-audit-plugin": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "plugins",
    "sandbox_runtime",
