# ==============================================================================
# Git Ignore: Security Audit Plugin
# ==============================================================================

# Node.js & TypeScript
node_modules/
dist/
build/
out/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo

# Rust & Cargo
target/
**/*.rs.bk
*.pdb

# Testing & Coverage
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment Variables & Secrets (Prevent Accidental Leaks)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
credentials
*.decoy

# Runtime Logs, Dumps & Sandbox Workspace
.evolve/
.deployment/
logs/
/workspace/
reports/
*.log
*.har
*.pcap
*.pcapng
*.sarif
opplan.json
plan/*
!plan/*.md
plans/

# IDE & OS Metadata
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
