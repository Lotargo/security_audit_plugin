# ==============================================================================
# Docker Ignore: Security Audit Plugin Sandbox
# Prevents host artifacts and secrets from being copied into Docker build context
# ==============================================================================

# Git & Version Control
.git/
.github/
.gitignore
.gitattributes

# Node.js & Host Dependencies
node_modules/
dist/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust Host Target Directory
target/
sandbox_runtime/target/

# IDE & Local Workspace Files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Documentation & Plans
plan/
IMPLEMENTATION_PLAN.md
CHANGELOG.md

# Local Environment Secrets & Logs
.env
.env.*
*.pem
*.key
logs/
reports/
*.log
*.sarif
opplan.json
