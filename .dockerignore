# ==============================================================================
# Docker Ignore: Security Audit Plugin Sandbox
# Prevents host artifacts and secrets from being copied into Docker build context
# ==============================================================================

# Git & Version Control
.git/
.github/
.gitignore
.gitattributes
.dockerignore

# Node.js & Host Dependencies
node_modules/
dist/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust Host Target Directory & Stealth node_modules
target/
sandbox_runtime/target/
sandbox_runtime/stealth/node_modules/
sandbox_runtime/stealth/package-lock.json

# Host TypeScript & Skills (Not needed inside Docker build context)
src/
tests/
skills/
plugins/
bin/

# IDE & Local Workspace Files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Documentation & Plans
plan/
plans/
IMPLEMENTATION_PLAN.md
CHANGELOG.md

# Local Environment Secrets & Logs
.env
.env.*
*.pem
*.key
logs/
reports/
*.log
*.sarif
opplan.json
