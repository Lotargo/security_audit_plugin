{
  "_meta": {
    "version": "1.0.0",
    "description": "Multi-signal WAF detection profiles ported from Decepticon & upgraded for Security Audit Plugin"
  },
  "akamai_bot_manager": {
    "name": "Akamai Bot Manager",
    "detectors": {
      "cookie": ["_abck", "bm_sz", "ak_bmsc", "bm_sv", "bm_so"],
      "header": ["x-akamai-*", "akamai-*"],
      "server_contains": ["akamaighost", "akamai"],
      "body": ["sec-if-cpt-container", "powered and protected by akamai", "akamai bot manager"]
    },
    "confidence_rules": {
      "strong": 2,
      "weak": 1
    },
    "capabilities_needed": ["needs_real_tls_stack", "needs_js_exec"],
    "evasion_strategy": {
      "tls_impersonate": ["chrome146", "safari17_0"],
      "referer": "self_root",
      "warmup_required": true,
      "recommendation": "Use persistent browser context with initial root domain warmup hop to clear sensor cookies."
    }
  },
  "cloudflare_turnstile": {
    "name": "Cloudflare Turnstile & Bot Management",
    "detectors": {
      "cookie": ["cf_clearance", "__cf_bm", "__cfduid"],
      "header": ["cf-ray", "cf-cache-status", "cf-mitigated"],
      "server_contains": ["cloudflare"],
      "body": ["just a moment...", "checking your browser", "cf-chl-bypass", "attention required! | cloudflare", "turnstile"]
    },
    "confidence_rules": {
      "strong": 2,
      "weak": 1
    },
    "capabilities_needed": ["needs_js_exec"],
    "evasion_strategy": {
      "tls_impersonate": ["chrome", "chrome_android"],
      "referer": "google_search",
      "warmup_required": true,
      "recommendation": "Use stealth browser with Bezier mouse movements to solve interactive or managed Turnstile challenges."
    }
  },
  "aws_waf": {
    "name": "AWS WAF / CloudFront",
    "detectors": {
      "cookie": ["aws-waf-token"],
      "header": ["x-amzn-requestid", "x-amzn-errortype", "x-amzn-waf-*", "x-amz-cf-id"],
      "server_contains": ["awselb", "cloudfront"],
      "body": ["aws waf", "request blocked by aws waf"]
    },
    "confidence_rules": {
      "strong": 2,
      "weak": 1
    },
    "capabilities_needed": ["needs_real_tls_stack"],
    "evasion_strategy": {
      "tls_impersonate": ["chrome", "safari"],
      "referer": "self_root",
      "warmup_required": false,
      "recommendation": "Rotate TLS fingerprint and apply IP rotation or Tor circuit reset."
    }
  },
  "f5_big_ip": {
    "name": "F5 BIG-IP ASM / Advanced WAF",
    "detectors": {
      "cookie": ["bigipserver*", "ts01*", "f5_*"],
      "header": ["x-cnection", "x-wa-info"],
      "server_contains": ["big-ip"],
      "body": ["the requested url was rejected", "please consult with your administrator", "support id:"]
    },
    "confidence_rules": {
      "strong": 2,
      "weak": 1
    },
    "capabilities_needed": ["needs_real_tls_stack"],
    "evasion_strategy": {
      "tls_impersonate": ["chrome", "safari"],
      "referer": "self_root",
      "warmup_required": false,
      "recommendation": "Inspect TS01 cookie decoding and evaluate L7 IP header spoofing (X-Forwarded-For)."
    }
  },
  "datadome": {
    "name": "DataDome Bot Protection",
    "detectors": {
      "cookie": ["datadome"],
      "header": ["x-datadome", "x-datadome-response"],
      "server_contains": ["datadome"],
      "body": ["datadome", "blocked by datadome", "geo.captcha-delivery.com"]
